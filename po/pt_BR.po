#: src/big_trust_alt/cli.py:18
msgid ""
"Identify downloaded programs and find the best way to use them on Linux."
msgstr "Identifique programas baixados e descubra a melhor maneira de usá-los no Linux."

#: src/big_trust_alt/cli.py:20
msgid "files to open in the window"
msgstr "arquivos para abrir na janela"

#: src/big_trust_alt/cli.py:21
msgid "analyze a file and print the result"
msgstr "analisa um arquivo e mostra o resultado"

#: src/big_trust_alt/cli.py:22
msgid "search the catalog for a program"
msgstr "procura um programa no catálogo"

#: src/big_trust_alt/cli.py:23
msgid "machine-readable output"
msgstr "saída para outros programas (JSON)"

#: src/big_trust_alt/cli.py:24
msgid "do not query the AUR over the network"
msgstr "não consulta o AUR pela rede"

#: src/big_trust_alt/cli.py:25
msgid "show the file associations"
msgstr "mostra as associações de arquivos"

#: src/big_trust_alt/cli.py:27
msgid ""
"make Big Trust Alt the default for downloaded programs and packages "
"(previous choices are saved)"
msgstr "torna o Big Trust Alt o padrão para programas e pacotes baixados (as escolhas anteriores são guardadas)"

#: src/big_trust_alt/cli.py:28
msgid "restore the previous file associations"
msgstr "restaura as associações de arquivos anteriores"

#: src/big_trust_alt/cli.py:29
msgid "print a diagnostics report without personal data"
msgstr "mostra um relatório de diagnóstico sem dados pessoais"

