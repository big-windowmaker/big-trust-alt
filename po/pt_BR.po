msgstr "Preferências"

#: src/big_trust_alt/ui/preferences.py:17
msgid "General"
msgstr "Geral"

#: src/big_trust_alt/ui/preferences.py:20
msgid "Sources"
msgstr "Fontes"

#: src/big_trust_alt/ui/preferences.py:21
msgid "Safety checks stay the same whatever you choose."
msgstr "As verificações de segurança são as mesmas, qualquer que seja a escolha."

#: src/big_trust_alt/ui/preferences.py:22
