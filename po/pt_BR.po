msgstr "Não consultados (sem rede ou indisponíveis): {names}"

#: src/big_trust_alt/cli.py:122
#, python-brace-format
msgid "Nothing found for “{text}”."
msgstr "Nada encontrado para “{text}”."

#: src/big_trust_alt/core/messages.py:11
msgid ""
"The name hides characters that change how it is displayed. The real "
"extension may not be the one you see."
msgstr "O nome esconde caracteres que mudam o jeito como ele aparece. A extensão real pode não ser a que você vê."

#: src/big_trust_alt/core/messages.py:13
msgid "The name contains invisible control characters."
msgstr "O nome contém caracteres de controle invisíveis."

#: src/big_trust_alt/core/messages.py:14
#, python-brace-format
msgid "Double extension ({detail}): a program disguised as a document?"
msgstr "Extensão dupla ({detail}): um programa disfarçado de documento?"

#: src/big_trust_alt/core/messages.py:15
msgid "Very long file name."
msgstr "Nome de arquivo muito longo."

#: src/big_trust_alt/core/messages.py:16
#, python-brace-format
msgid "The extension says document, but the content is a program ({detail})."
msgstr "A extensão diz documento, mas o conteúdo é um programa ({detail})."

#: src/big_trust_alt/core/messages.py:17
#, python-brace-format
msgid "The extension does not match the content ({detail})."
msgstr "A extensão não corresponde ao conteúdo ({detail})."

#: src/big_trust_alt/core/messages.py:18
#, python-brace-format
msgid "Built for another processor ({detail})."
msgstr "Feito para outro processador ({detail})."

#: src/big_trust_alt/core/messages.py:19
msgid "No digital signature."
msgstr "Sem assinatura digital."

#: src/big_trust_alt/core/messages.py:20
msgid "Has a digital signature; it was not verified here."
msgstr "Tem assinatura digital; ela não foi verificada aqui."

#: src/big_trust_alt/core/messages.py:21
msgid "Asks Windows for administrator rights when it runs."
msgstr "Pede ao Windows permissão de administrador ao ser executado."

#: src/big_trust_alt/core/messages.py:22
msgid "Uses .NET (Mono or wine-mono needed to run it under Wine)."
msgstr "Usa .NET (precisa do Mono ou do wine-mono para rodar no Wine)."

#: src/big_trust_alt/core/messages.py:23
#, python-brace-format
msgid "The file looks damaged or truncated ({detail})."
msgstr "O arquivo parece danificado ou incompleto ({detail})."

#: src/big_trust_alt/core/messages.py:24
msgid "The file is empty."
msgstr "O arquivo está vazio."

#: src/big_trust_alt/core/messages.py:25
#, python-brace-format
msgid "Opened through a symbolic link to {detail}."
msgstr "Aberto por um link simbólico para {detail}."

#: src/big_trust_alt/core/messages.py:26
msgid "Other users can change this file."
msgstr "Outros usuários podem alterar este arquivo."

#: src/big_trust_alt/core/messages.py:27
#, python-brace-format
msgid "Adds packages from a third-party Flatpak remote ({detail})."
msgstr "Adiciona pacotes de um repositório Flatpak de terceiros ({detail})."

#: src/big_trust_alt/core/messages.py:28
msgid "Contains Windows libraries: may not work on Linux."
msgstr "Contém bibliotecas do Windows: pode não funcionar no Linux."

#: src/big_trust_alt/core/messages.py:29
#, python-brace-format
msgid "Contains Windows programs: {detail}."
msgstr "Contém programas do Windows: {detail}."

#: src/big_trust_alt/core/messages.py:30
msgid "Downloads and runs code from the internet."
msgstr "Baixa e executa código da internet."

#: src/big_trust_alt/core/messages.py:31
msgid "Asks for administrator rights (sudo/pkexec)."
msgstr "Pede permissão de administrador (sudo/pkexec)."

#: src/big_trust_alt/core/messages.py:32
msgid "Deletes folders recursively."
msgstr "Apaga pastas com todo o conteúdo."

#: src/big_trust_alt/core/messages.py:33
msgid "Writes to disks or partitions directly."
msgstr "Grava diretamente em discos ou partições."

#: src/big_trust_alt/core/messages.py:34
msgid "Changes system files."
msgstr "Altera arquivos do sistema."

#: src/big_trust_alt/core/messages.py:35
msgid "Makes files writable by everyone (chmod 777)."
msgstr "Deixa arquivos graváveis por todos (chmod 777)."

#: src/big_trust_alt/core/messages.py:36
msgid "Contains hidden or encoded code."
msgstr "Contém código escondido ou codificado."

#: src/big_trust_alt/core/messages.py:37
msgid "Configures something to start automatically."
msgstr "Configura algo para iniciar automaticamente."

#: src/big_trust_alt/core/messages.py:38
msgid "Carries an embedded binary payload."
msgstr "Carrega um conteúdo binário embutido."

#: src/big_trust_alt/core/messages.py:46
msgid "The file does not exist (it may have been moved or deleted)."
msgstr "O arquivo não existe (pode ter sido movido ou apagado)."

#: src/big_trust_alt/core/messages.py:47
msgid "You do not have permission to read this file."
msgstr "Você não tem permissão para ler este arquivo."

