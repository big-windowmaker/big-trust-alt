msgstr "Não é um arquivo comum (pasta, dispositivo ou pipe)."

#: src/big_trust_alt/core/messages.py:49
msgid "The file could not be read."
msgstr "Não foi possível ler o arquivo."

#: src/big_trust_alt/core/messages.py:50
msgid "Analysis cancelled."
msgstr "Análise cancelada."

